---
import { getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { originOf, recordGraph } from "../../lib/archive.ts";
import { summarize } from "../../lib/present.ts";
import { loadRecords } from "../../lib/records.ts";
import { neighbors } from "../../lib/sequence.ts";
import type { PublicRecord } from "../../lib/types.ts";

export async function getStaticPaths() {
  const records = await loadRecords();
  return records.map((record) => {
    const { prev, next } = neighbors(records, record.id);
    return {
      params: { slug: record.id },
      props: {
        record,
        prev: prev && { href: prev.href, heading: prev.heading },
        next: next && { href: next.href, heading: next.heading },
      },
    };
  });
}

interface Link {
  href: string;
  heading: string;
}

interface Props {
  record: PublicRecord;
  prev: Link | null;
  next: Link | null;
}

const { record, prev, next } = Astro.props;
const entry = await getEntry("transients", record.id);
if (!entry) throw new Error(`Missing transient entry ${record.id}`);
const { Content } = await render(entry);
const description = summarize(record, entry.body);
const site = originOf(Astro.site);
const onMap = record.lat != null && record.lon != null;
const shareDescription =
  [record.coordLine, record.localLine ?? record.utc].filter(Boolean).join(" · ") || description;
const shareImage = record.images[0];
---

<Base
  title={`${record.heading} — latlon.art`}
  description={description}
  robots={record.draft ? "noindex" : undefined}
  jsonLd={recordGraph(record, site, description)}
  shareTitle={record.heading}
  shareDescription={shareDescription}
  ogType="article"
  image={shareImage}
>
  {prev && <link slot="head" rel="prev" href={prev.href} />}
  {next && <link slot="head" rel="next" href={next.href} />}
  <p class="back"><a href="/">latlon.art</a></p>
  <h1>{record.heading}</h1>
  {
    record.images.length > 0 && (
      <div class:list={["leads", { multi: record.images.length > 1 }]}>
        {record.images.map((image) => (
          <figure class="lead">
            <img
              src={image.src}
              alt={image.alt}
              width={image.width}
              height={image.height}
              loading="eager"
              decoding="async"
            />
            {image.caption && <figcaption>{image.caption}</figcaption>}
          </figure>
        ))}
      </div>
    )
  }
  {record.subtitle && <p>{record.subtitle}</p>}

  <div class="block">
    <p class="label">{record.tid ? "TID" : "TID incomplete"}</p>
    {record.tidPartial && <p translate="no">{record.tidPartial}</p>}
  </div>

  <div class="block" translate="no">
    <p class="label">Latitude</p>
    <p class:list={[{ quiet: !record.latText }]}>{record.latText ?? (record.hidden ? "Coordinates withheld" : "Not recorded")}</p>
  </div>
  <div class="block" translate="no">
    <p class="label">Longitude</p>
    <p class:list={[{ quiet: !record.lonText }]}>{record.lonText ?? (record.hidden ? "Coordinates withheld" : "Not recorded")}</p>
  </div>
  <div class="block" translate="no">
    <p class="label">Altitude</p>
    <p class:list={[{ quiet: !record.altitudeText }]}>{record.altitudeText ?? "Not recorded"}</p>
  </div>
  <div class="block" translate="no">
    <p class="label">UTC</p>
    {
      record.utc ? (
        <p>
          <time datetime={record.utc}>{record.utc}</time>
        </p>
      ) : (
        <p class="quiet">Not recorded</p>
      )
    }
  </div>

  {
    record.localLine && (
      <p class="block" translate="no">
        {record.localLine}
      </p>
    )
  }
  {
    record.recordedLocal && (
      <p class="quiet" translate="no">
        As recorded {record.recordedLocal}
      </p>
    )
  }
  {record.place && <p class="block">{record.place}</p>}
  {record.medium && <p class="quiet">{record.medium}</p>}
  {
    record.source && (
      <p class="quiet">
        <a href={record.source}>Source</a>
      </p>
    )
  }
  <p class="quiet" translate="no">
    <a href={record.href}>{record.href}</a>
  </p>
  {
    onMap && (
      <p class="quiet">
        <a href={`/map#${record.id}`}>Map</a>
      </p>
    )
  }

  {
    entry.body?.trim() && (
      <div class="prose">
        <Content />
      </div>
    )
  }
  {
    (prev || next) && (
      <nav class="seq" aria-label="Transients in sequence">
        {prev && (
          <a class="prev" href={prev.href} rel="prev" aria-label={`Previous: ${prev.heading}`} title={prev.heading}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 18l-6-6 6-6" vector-effect="non-scaling-stroke" /></svg></a>
        )}
        {next && (
          <a class="next" href={next.href} rel="next" aria-label={`Next: ${next.heading}`} title={next.heading}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 18l6-6-6-6" vector-effect="non-scaling-stroke" /></svg></a>
        )}
      </nav>
    )
  }
  <script is:inline>
    document.addEventListener("keydown", (e) => {
      if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
      const t = e.target;
      if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
      const sel = { ArrowLeft: ".seq .prev", ArrowRight: ".seq .next" }[e.key];
      const a = sel && document.querySelector(sel);
      if (a) location.href = a.href;
    });
  </script>
</Base>
