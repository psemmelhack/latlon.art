---
import Base from "../layouts/Base.astro";
import { originOf } from "../lib/archive.ts";

const site = originOf(Astro.site);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${site}/what`,
  url: `${site}/what`,
  name: "What",
  isPartOf: { "@id": `${site}/#site` },
};
---

<Base
  title="What — latlon.art"
  description="The complete measurable description of someone or something at a particular time and place."
  robots="noindex"
  jsonLd={jsonLd}
>
  <p><a href="/">latlon.art</a></p>
  <h1>What</h1>
  <p class="prose">A transient is the complete measurable description of someone or something at a particular time and place. It encompasses every possible measurement of its physical existence there and then, whether or not those measurements can ever be taken.</p>
  <p class="prose">Practical and artistic expressions of a transient capture selections from that totality. Inscribed on an object, those measurements give it a particular relationship to where and when it belongs. Moving it can break the agreement between description and presence. Returning it can restore the spatial agreement, but its original moment can never be recovered.</p>
  <p class="quiet apart"><a href="/">The transients.</a></p>
</Base>
