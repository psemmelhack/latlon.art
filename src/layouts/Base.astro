---
import { jsonLd } from "../lib/archive.ts";

interface Props {
  title: string;
  description: string;
  robots?: string;
  jsonLd?: unknown;
  /** Title for link previews. Defaults to the page title. */
  shareTitle?: string;
  /** Description for link previews. Defaults to the page description. */
  shareDescription?: string;
  ogType?: "website" | "article";
  /** Share image as a site path or https URL. Defaults to /og.png. */
  image?: { src: string; alt: string; width?: number; height?: number };
}

const DEFAULT_IMAGE = {
  src: "/og.png",
  alt: "latlon.art — transients",
  width: 1200,
  height: 630,
};

const { title, description, robots = "noindex", jsonLd: data, shareTitle, shareDescription, ogType = "website", image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const share = image ?? DEFAULT_IMAGE;
const shareImage = new URL(share.src, Astro.site).href;
const ogTitle = shareTitle ?? title;
const ogDescription = shareDescription ?? description;
const structured = data ? jsonLd(data) : "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/json" href="/transients.json" title="Transient index" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:site_name" content="latlon.art" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    {share.width && <meta property="og:image:width" content={String(share.width)} />}
    {share.height && <meta property="og:image:height" content={String(share.height)} />}
    <meta property="og:image:alt" content={share.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={share.alt} />
    <style is:global>
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        color: #000;
        background: #fff;
        font: 17px/1.7 ui-monospace, Menlo, Consolas, "DejaVu Sans Mono", monospace;
      }
      main { max-width: 58rem; margin: 0 auto; padding: 30vh 1.5rem 6rem; overflow-wrap: anywhere; }
      h1 { font-size: 1.25rem; font-weight: bold; margin: 0 0 1.2rem; }
      /* back-link above a subpage heading: same gap as the homepage title -> line */
      .back { margin: 0 0 1.2rem; }
      h2 { font-size: 1rem; font-weight: bold; margin: 0 0 0.4rem; }
      p { margin: 0; }
      .line { margin: 0 0 3lh; }
      a { color: #000; text-underline-offset: 3px; }
      .label {
        font-size: 0.8rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #555;
        margin: 0 0 0.5rem;
      }
      .quiet { margin: 0.9rem 0 0; font-size: 0.85rem; color: #555; }
      .quiet a { color: #555; }
      .quiet.apart { margin-top: 4.8rem; }
      .list { display: grid; gap: 4.8rem; margin-top: 6rem; }
      .list article p { margin-top: 0.15rem; }
      .block { margin-top: 2.4rem; }
      .prose { margin-top: 3rem; max-width: 36rem; }
      .prose p { margin: 0 0 1rem; }
      figure { margin: 2.4rem 0 0; }
      img { max-width: 100%; height: auto; display: block; }
      figcaption { margin-top: 0.4rem; font-size: 0.85rem; color: #555; }
      footer {
        max-width: 58rem;
        margin: 0 auto;
        padding: 0 1.5rem 4rem;
        font-size: 0.85rem;
        color: #555;
      }
      footer a { color: #555; }
      @media (min-width: 760px) {
        body { font-size: 18px; }
      }
    </style>
    {structured && <script type="application/ld+json" is:inline set:html={structured} />}
  </head>
  <body>
    <main>
      <slot />
    </main>
    <footer>— Peter Semmelhack · <a href="https://psem.me/">psem.me</a></footer>
  </body>
</html>
